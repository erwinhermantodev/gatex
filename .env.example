APP_PORT=
AUTH_SERVICE_BASE_URL=
AUTH_SERVICE_GRPC_ADDR=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
# Required: token for /admin/* (requests are rejected if unset)
ADMIN_API_TOKEN=
# Optional: comma-separated CORS origins (default "*")
CORS_ALLOW_ORIGINS=
# Optional: days to keep request/trace logs, 0 keeps forever (default 7)
LOG_RETENTION_DAYS=
# Optional: set to "false" when clients connect directly (ignores X-Forwarded-For for rate limiting)
TRUST_PROXY_HEADERS=
