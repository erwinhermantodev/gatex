APP_PORT=
AUTH_SERVICE_BASE_URL=
AUTH_SERVICE_GRPC_ADDR=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
# Required: token for /admin/* (requests are rejected if unset)
ADMIN_API_TOKEN=
# Optional: comma-separated CORS origins (default "*")
CORS_ALLOW_ORIGINS=
# Optional: days to keep request/trace logs, 0 keeps forever (default 7)
LOG_RETENTION_DAYS=
# Optional: set to "false" when clients connect directly (ignores X-Forwarded-For for rate limiting)
TRUST_PROXY_HEADERS=
# Optional: allow upstreams on localhost/127.0.0.1 (dev only; blocked by default)
ALLOW_LOOPBACK_UPSTREAMS=
# Route auth middleware "jwt": HS256 secret and/or RS256 public key (PEM); optional issuer/audience
JWT_SECRET=
JWT_PUBLIC_KEY_PEM=
JWT_ISSUER=
JWT_AUDIENCE=
# Route auth middleware "api-key": comma-separated accepted keys (header x-api-key)
API_KEYS=
